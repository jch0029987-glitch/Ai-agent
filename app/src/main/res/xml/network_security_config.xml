<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration permits user CAs globally for debugging/proxies -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext overrides for local development and local network bridges -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.5</domain>
        <domain includeSubdomains="true">192.168.49.1</domain>
    </domain-config>
</network-security-config>
